# GitHub OAuth Application Credentials
# Copy this file to .env and fill in your credentials from GitHub Developer Settings
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Claude / OpenRouter AI Copilot Key (Optional: Can also be set in Browser Settings)
CLAUDE_API_KEY=your_claude_or_openrouter_api_key_here
OPENROUTER_API_KEY=your_claude_or_openrouter_api_key_here
